# All optional. Copy to .env (never commit .env).

# Where default output goes (clippings/, skills/, Documents/<slug>/). Default: ./output
# KNOWLEDGE_ROOT=/path/to/knowledge-or-obsidian-vault
# OBSIDIAN_VAULT_PATH=/path/to/obsidian/vault

# Route default output to /srv/knowledge (server preset)
# HOST_ENV=remote

# Use Postgres (e.g. Neon) instead of SQLite ./docs.db for the index
# DATABASE_URL=postgres://user:password@host/db

# Raise GitHub API rate limits for github-docs / skill downloads
# GITHUB_TOKEN=

# Use an installed browser instead of Playwright's bundled Chromium
# DOC_DL_BROWSER_CHANNEL=chrome
# DOC_DL_CHROMIUM_PATH=/usr/bin/chromium

# Enable live tests (real websites + browser): npm run test:live
# DOC_DL_LIVE_TESTS=1

# Verbose logging
# DEBUG=1
