{
  "name": "ai-doc-downloader",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "bin": {
    "docs_dl": "./bin/docs_dl",
    "ddocs": "./bin/ddocs",
    "docdownloader-clip": "./dist/src/scripts/clip.js",
    "docdownloader-skill": "./dist/src/skills/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.js",
    "start": "node dist/src/index.js",
    "import-docs": "tsc && node dist/src/scripts/importDocs.js",
    "process-list": "tsc && node dist/src/scripts/processList.js",
    "clip": "tsc && node dist/src/scripts/clip.js",
    "github-docs": "tsc && node dist/src/github_docs/index.js",
    "skill": "tsc && node dist/src/skills/index.js",
    "download-skill": "tsc && node dist/src/skills/index.js",
    "docs:typedoc": "typedoc",
    "docs:sphinx": "typedoc && sphinx-build -b html docs docs/build/sphinx",
    "docs": "npm run docs:typedoc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "A TypeScript-based web crawler that downloads web pages and converts them to Markdown format",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "playwright": "^1.42.1",
    "turndown": "^7.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.24",
    "@types/turndown": "^5.0.4",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3"
  }
}
