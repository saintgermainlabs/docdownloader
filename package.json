{
  "name": "ai-doc-downloader",
  "version": "1.0.0",
  "description": "Universal documentation downloader: crawls docs sites (incl. JS-rendered SPAs) and GitHub repos into clean Markdown, with a SQLite/Postgres index for resumable crawls.",
  "keywords": [
    "documentation",
    "docs",
    "crawler",
    "scraper",
    "markdown",
    "playwright",
    "spa",
    "github",
    "offline-docs",
    "llm",
    "rag"
  ],
  "homepage": "https://github.com/saintgermainlabs/docdownloader#readme",
  "bugs": {
    "url": "https://github.com/saintgermainlabs/docdownloader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saintgermainlabs/docdownloader.git"
  },
  "license": "ISC",
  "author": "Saint Germain Labs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "docs_dl": "./bin/docs_dl",
    "ddocs": "./bin/ddocs",
    "docdownloader-clip": "./dist/src/scripts/clip.js",
    "docdownloader-skill": "./dist/src/skills/index.js",
    "doc-dl-detect": "./dist/src/cli/detect.js"
  },
  "files": [
    "dist/src",
    "bin",
    "README.md",
    "GUIDE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.js",
    "start": "node dist/src/index.js",
    "import-docs": "tsc && node dist/src/scripts/importDocs.js",
    "process-list": "tsc && node dist/src/scripts/processList.js",
    "clip": "tsc && node dist/src/scripts/clip.js",
    "github-docs": "tsc && node dist/src/github_docs/index.js",
    "skill": "tsc && node dist/src/skills/index.js",
    "download-skill": "tsc && node dist/src/skills/index.js",
    "docs:typedoc": "typedoc",
    "docs:sphinx": "typedoc && sphinx-build -b html docs docs/build/sphinx",
    "docs": "npm run docs:typedoc",
    "prepublishOnly": "npm run build",
    "detect": "tsc && node dist/src/cli/detect.js",
    "test:live": "DOC_DL_LIVE_TESTS=1 npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1",
    "playwright": "^1.42.1",
    "turndown": "^7.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@neon/config": "^1.9.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.24",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.4",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.3.3"
  }
}
